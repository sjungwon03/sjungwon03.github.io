---
layout: null
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <id>{{ site.url }}{{ site.baseurl }}/</id>
  <link href="{{ '/feed.xml' | absolute_url }}" rel="self"/>
  <link href="{{ site.url }}{{ site.baseurl }}/"/>
  <updated>{% if site.posts.first %}{{ site.posts.first.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.author }}</name><email>{{ site.email }}</email></author>
  {% for post in site.posts limit: 20 %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 300 | xml_escape }}</summary>
    <content type="html">{{ post.content | xml_escape }}</content>
  </entry>
  {% endfor %}
</feed>
